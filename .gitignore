# Local source material and execution specifications. Root-level office
# documents and private build specs are intentionally excluded.
/*.docx
/*_Spec_*.md

# Rehearsal notes for the panel. SECURITY.md forbids committing internal
# briefing documents, and a demo script with anticipated questions is one.
/demo-prep/

# Dependencies and build output
node_modules/
dist/
coverage/
.vite/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs and local tooling
*.log
.DS_Store
.idea/
.vscode/
.claude/
/.config/

# Vercel CLI project links. These carry project and organisation identifiers
# for a specific account and must not be committed.
.vercel/
